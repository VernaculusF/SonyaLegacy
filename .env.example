# Sonya Environment Configuration
# Copy this to .env and fill in your values
# WARNING: .env is gitignored — never commit real secrets

# === LLM Provider ===
SONYA_LLM_API_BASE=https://openrouter.ai/api/v1
SONYA_LLM_MODEL=google/gemma-2-27b-it:free
SONYA_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# === Telegram Userbot ===
# Get api_id/api_hash from https://my.telegram.org
SONYA_TG_API_ID=0
SONYA_TG_API_HASH=
SONYA_TG_SESSION_PATH=./tg.session

# === Admin Panel ===
SONYA_ADMIN_PASSWORD=
# Where admin binds. 127.0.0.1 = loopback only (use SSH tunnel for remote access)
# SONYA_ADMIN_BIND_HOST=127.0.0.1
# SONYA_ADMIN_PORT=8877

# === Runtime Toggles ===
# Set to 0 to disable a subsystem (admin can also toggle these per-start via UI)
SONYA_ENABLE_TELEGRAM=1
SONYA_ENABLE_THINKING=1

# === Initiative (Соня пишет первой) ===
# Telegram chat_id of the primary user. Without it, initiative is disabled.
# This same value also acts as the DM allowlist — only this sender_id (plus any
# in SONYA_TG_ALLOWED_EXTRA_SENDERS) gets a planner-generated reply in private DMs.
SONYA_PRIMARY_USER_TG_ID=
# Optional: comma-separated extra tg sender_ids allowed to talk to Sonya
# SONYA_TG_ALLOWED_EXTRA_SENDERS=12345,67890
# Max self-initiated messages per UTC day
SONYA_INITIATIVE_MAX_PER_DAY=5
# Minimum minutes since last incoming/outgoing TG event before initiative is allowed
SONYA_INITIATIVE_MIN_QUIET_MINUTES=90

# === Atrium Этап 1.5 — TG emergency-only mode ===
# When 1, chat.dialog is suppressed from Telegram while Atrium is the live
# primary surface (seen within the threshold below). Real emergencies
# (chat.emergency, or Atrium offline past threshold) still reach TG.
# Keep 0 until Atrium is stable on Ivan's devices.
SONYA_TG_EMERGENCY_MODE=0
# Hours of Atrium silence before TG resumes as the dialog fallback.
SONYA_TG_EMERGENCY_THRESHOLD_HOURS=24

# === Paths (optional — defaults to ~/.sonya/) ===
# SONYA_SUBSTRATE_PATH=./sonya_substrate.db
# SONYA_HEALTH_PATH=./health.json

# === Admin core process management (used when admin starts core via UI) ===
# SONYA_PROJECT_ROOT=/home/jester-sonya/Sonya
# SONYA_VENV_PYTHON=/home/jester-sonya/Sonya/.venv/bin/python
# SONYA_CORE_LOG_PATH=/tmp/sonya.log

# === Logging ===
SONYA_LOG_LEVEL=INFO

# ElevenLabs TTS — Atrium voice proxy (key never goes to browser).
# Get from elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=
