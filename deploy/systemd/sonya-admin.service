[Unit]
Description=Sonya admin web panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jester-sonya
Group=jester-sonya
WorkingDirectory=/home/jester-sonya/Sonya
EnvironmentFile=/home/jester-sonya/Sonya/.env
Environment="PYTHONPATH=/home/jester-sonya/Sonya/src:/home/jester-sonya/Sonya/packages/tg-userbot/src"
ExecStart=/home/jester-sonya/Sonya/.venv/bin/python -m sonya.admin
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
