.venv/
__pycache__/
.pytest_cache/
dist/
build/
*.egg-info/
tg.session
tg.session-journal
*.sqlite
.env

# Sonya personal scratch space — research notes, session dumps, intermediate work.
# Not code, not docs. Per-instance state on VPS; snapshotted in ~/.sonya/backups.
workspace/
research/

# DB files in project root (dev only). Substrate proper at ~/.sonya/sonya_substrate.db.
sonya.db
sonya.db-*
openrouter_keys.txt

# Sonya plugin scratch — agent-created plugins for one-off tasks (hot-loaded on VPS).
src/sonya/tools/plugins/*
!src/sonya/tools/plugins/__init__.py
tmp_commit_msg.txt
tmp_*.py
tmp_*.sh
tmp_*.txt

# Sonya knowledge base — markdown facts she creates / edits. Lives in
# ~/.sonya/knowledge/ on every host (substrate-side). НЕ в repo —
# исторически она дублировала в knowledge-base/, knowledge_base/,
# data/payloads/ и даже в корень репо, что создавало мусор.
# Файлы там теперь блокированы (filesystem._check_writable) и
# мигрируются в ~/.sonya/knowledge/ на старте.
knowledge-base/
knowledge_base/
data/payloads/
payloads/
kb/
# Stray doc/data dumps at repo root (bad fetches, scratch). Real facts →
# knowledge.write. These globs catch the common accidents без блокировки
# легитимных README.md / pyproject.toml.
/*.csv
/*.html

# 3D avatar models (VRM/FBX/GLB). Большие бинарники, не в git — у Ивана локально,
# на VPS не нужны (рендер клиентский). Atrium грузит из своей assets-папки.
model/
*.vrm
*.fbx
*.glb

# 2D avatar sprites — generated from Ivan's source 2B images (personal assets).
# Render is client-side; not committed. Regenerate via tools/process_avatar.py.
packages/atrium/public/avatar/

# Isolated venv for image tooling (rembg etc) — not part of core.
.venv-imgtools/

# Local TTS service — own venv (heavy: torch + silero), model cache.
services/tts/.venv/
services/tts/.cache/
